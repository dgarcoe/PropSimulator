{
  "name": "PropSimulator",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  // Runs once, when the Codespace is created.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Runs every time you attach, including after a stop/resume. The script is
  // idempotent: if the server is already listening it prints the URL and
  // exits instead of failing with "address already in use".
  "postAttachCommand": "bash scripts/serve.sh --background",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "PropSimulator web",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": ["tests"],
        "files.trimTrailingWhitespace": true,
        "[python]": {
          "editor.rulers": [88]
        }
      }
    }
  }
}
