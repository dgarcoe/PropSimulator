{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web interface",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      // 0.0.0.0, not localhost: the Codespaces port forwarder reaches the
      // process from outside the container's network namespace.
      "args": ["api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "CLI: Madrid to London",
      "type": "debugpy",
      "request": "launch",
      "module": "propsim.cli",
      "args": [
        "--tx-lat", "40.4", "--tx-lon", "-3.7", "--tx-name", "Madrid",
        "--rx-lat", "51.5", "--rx-lon", "-0.1", "--rx-name", "London",
        "--f107", "140", "--sunspots", "60", "--kp", "2", "--reliability"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Current test file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
